# API runtime (pooled URL on Supabase)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/susi_air
# Migrations and seed (non-pooling URL on Supabase). Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:5433/susi_air
# Set to true for Supabase (TLS with certificate verification)
DATABASE_SSL=false
# Optional PEM CA for Supabase, only if the default trust store rejects its certificate
# DATABASE_SSL_CA=
# API port (default 3001)
PORT=3001
# Web SSR calls the API origin here (default http://localhost:3001). Set by the Vercel service binding in production.
NUXT_API_INTERNAL_BASE=http://localhost:3001
