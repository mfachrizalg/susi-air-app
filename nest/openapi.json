{
  "openapi": "3.0.0",
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EnvelopeDoc"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/LoginResultDto"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "tags": [
          "Auth"
        ]
      }
    },
    "/pilot/me": {
      "get": {
        "operationId": "PilotController_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EnvelopeDoc"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/PilotMeDto"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "cookie": []
          }
        ],
        "tags": [
          "Pilot"
        ]
      }
    },
    "/flight-hours": {
      "get": {
        "operationId": "FlightHoursController_list",
        "parameters": [
          {
            "name": "from",
            "required": true,
            "in": "query",
            "description": "First day, inclusive (YYYY-MM-DD).",
            "schema": {
              "example": "2026-05-01",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": true,
            "in": "query",
            "description": "Last day, inclusive (YYYY-MM-DD). Span max 366 days.",
            "schema": {
              "example": "2026-05-15",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EnvelopeDoc"
                    },
                    {
                      "properties": {
                        "data": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/FlightHourDto"
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "cookie": []
          }
        ],
        "tags": [
          "FlightHours"
        ]
      }
    },
    "/flight-hours/summary": {
      "get": {
        "operationId": "FlightHoursController_summary",
        "parameters": [
          {
            "name": "range",
            "required": true,
            "in": "query",
            "schema": {
              "example": "1w",
              "type": "string",
              "enum": [
                "1w",
                "1m",
                "3m",
                "6m",
                "1y"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EnvelopeDoc"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/FlightHoursSummaryDto"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "cookie": []
          }
        ],
        "tags": [
          "FlightHours"
        ]
      }
    },
    "/documents": {
      "get": {
        "operationId": "DocumentsController_list",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EnvelopeDoc"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/DocumentsDto"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "cookie": []
          }
        ],
        "tags": [
          "Documents"
        ]
      }
    },
    "/schedules": {
      "get": {
        "operationId": "SchedulesController_month",
        "parameters": [
          {
            "name": "year",
            "required": true,
            "in": "query",
            "description": "Four digits.",
            "schema": {
              "example": "2026",
              "type": "string"
            }
          },
          {
            "name": "month",
            "required": true,
            "in": "query",
            "description": "01 to 12.",
            "schema": {
              "example": "05",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/EnvelopeDoc"
                    },
                    {
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/SchedulesDto"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          },
          {
            "cookie": []
          }
        ],
        "tags": [
          "Schedules"
        ]
      }
    }
  },
  "info": {
    "title": "Susi Air Pilot API",
    "description": "",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "token"
      },
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "EnvelopeDoc": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "statusCode": {
            "type": "number",
            "example": 200
          },
          "message": {
            "type": "string",
            "example": "OK"
          }
        },
        "required": [
          "success",
          "statusCode",
          "message"
        ]
      },
      "LoginResultDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "HS256 JWT. The same token is set as the httpOnly `token` cookie."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-05-15T16:00:00.000Z"
          }
        },
        "required": [
          "token",
          "expiresAt"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "johndoe"
          },
          "password": {
            "type": "string",
            "example": "susiairtest"
          }
        },
        "required": [
          "username",
          "password"
        ]
      },
      "PilotMeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "totalFlightHours": {
            "type": "number",
            "example": 1444.5,
            "description": "Profile total. Includes hours logged after today."
          },
          "avatarUrl": {
            "type": "string",
            "example": "http://localhost:3001/assets/avatar.svg"
          },
          "today": {
            "type": "string",
            "format": "date",
            "example": "2026-05-15"
          }
        },
        "required": [
          "name",
          "totalFlightHours",
          "avatarUrl",
          "today"
        ]
      },
      "FlightHourDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-05-15"
          },
          "hours": {
            "type": "number",
            "example": 6.4
          }
        },
        "required": [
          "date",
          "hours"
        ]
      },
      "SummaryPointDto": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "example": "2026-05-08"
          },
          "hours": {
            "type": "number",
            "example": 15
          },
          "projected": {
            "type": "boolean",
            "description": "True after today. The hours are planned."
          }
        },
        "required": [
          "date",
          "hours",
          "projected"
        ]
      },
      "SummaryCardDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "daily",
              "weekly",
              "monthly",
              "annual"
            ]
          },
          "label": {
            "type": "string",
            "example": "Weekly"
          },
          "hours": {
            "type": "number",
            "example": 25.2
          },
          "limit": {
            "type": "number",
            "example": 40
          }
        },
        "required": [
          "key",
          "label",
          "hours",
          "limit"
        ]
      },
      "FlightHoursSummaryDto": {
        "type": "object",
        "properties": {
          "range": {
            "type": "string",
            "enum": [
              "1w",
              "1m",
              "3m",
              "6m",
              "1y"
            ],
            "example": "1w"
          },
          "limit": {
            "type": "number",
            "example": 40,
            "description": "Limit for the selected range."
          },
          "max": {
            "type": "number",
            "example": 45,
            "description": "Top of the chart axis."
          },
          "windowDays": {
            "type": "number",
            "example": 7,
            "description": "Length of each rolling window in days."
          },
          "points": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SummaryPointDto"
            }
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SummaryCardDto"
            }
          }
        },
        "required": [
          "range",
          "limit",
          "max",
          "windowDays",
          "points",
          "cards"
        ]
      },
      "DocumentDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "doc_recurrent"
          },
          "label": {
            "type": "string",
            "example": "Next Recurrent Date"
          },
          "expiryDate": {
            "type": "string",
            "format": "date",
            "example": "2026-10-14"
          },
          "daysRemaining": {
            "type": "number",
            "example": 152,
            "description": "Days from today to the expiry date. Negative once expired."
          },
          "status": {
            "type": "string",
            "enum": [
              "safe",
              "soon",
              "expired"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "expiryDate",
          "daysRemaining",
          "status"
        ]
      },
      "DocumentsDto": {
        "type": "object",
        "properties": {
          "warningDays": {
            "type": "number",
            "example": 30,
            "description": "Window for the soon status, in days."
          },
          "documents": {
            "description": "In file order.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DocumentDto"
            }
          }
        },
        "required": [
          "warningDays",
          "documents"
        ]
      },
      "LegendEntryDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "TRX"
          },
          "label": {
            "type": "string",
            "example": "Training"
          },
          "color": {
            "type": "string",
            "example": "#F59E0B"
          }
        },
        "required": [
          "code",
          "label",
          "color"
        ]
      },
      "ScheduleDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "97027"
          },
          "duty_date": {
            "type": "string",
            "format": "date",
            "example": "2026-05-15"
          },
          "status": {
            "type": "number",
            "example": 1,
            "description": "Raw value from the file: 1 pending, 2 completed."
          },
          "base_name": {
            "type": "string",
            "example": "MKW"
          },
          "base_color": {
            "type": "string",
            "example": "#10B981",
            "description": "Fill colour of the day cell."
          },
          "duty_type": {
            "type": "string",
            "example": "DTY"
          },
          "count_schedules": {
            "type": "number",
            "example": 6,
            "description": "Planned flights or duties for the day."
          },
          "count_logbooks": {
            "type": "number",
            "example": 6,
            "description": "Flights or duties already logged."
          },
          "label": {
            "type": "string",
            "example": "MKW",
            "description": "base_name on DTY days, duty_type otherwise."
          },
          "remaining": {
            "type": "number",
            "example": 0,
            "description": "max(0, count_schedules - count_logbooks)."
          }
        },
        "required": [
          "id",
          "duty_date",
          "status",
          "base_name",
          "base_color",
          "duty_type",
          "count_schedules",
          "count_logbooks",
          "label",
          "remaining"
        ]
      },
      "SchedulesDto": {
        "type": "object",
        "properties": {
          "year": {
            "type": "number",
            "example": 2026
          },
          "month": {
            "type": "number",
            "example": 5
          },
          "legend": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LegendEntryDto"
            }
          },
          "schedules": {
            "description": "Rows for the month, in file order.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleDto"
            }
          }
        },
        "required": [
          "year",
          "month",
          "legend",
          "schedules"
        ]
      }
    }
  }
}
