# Copy to .env for local runs. The app reads process.env only, so export these
# in your shell or start with: node --env-file=.env dist/main.js
PORT=3001
# Reference date for every rule. The app never reads the system clock.
TODAY=2026-05-15
# Required when NODE_ENV=production. Use a long random string.
JWT_SECRET=change-me
# Token lifetime, for example 8h, 30m or 3600s.
JWT_TTL=8h
# Base for avatarUrl. No trailing slash.
PUBLIC_URL=http://localhost:3001
# Defaults to true when NODE_ENV=production. Keep false for plain http locally.
COOKIE_SECURE=false
# Login. Required when NODE_ENV=production. Dev and tests default to johndoe / susiairtest.
LOGIN_USERNAME=johndoe
LOGIN_PASSWORD=susiairtest
# Set NODE_ENV=production on Railway.
NODE_ENV=development
